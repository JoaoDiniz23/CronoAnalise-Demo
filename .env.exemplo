# Modelo de variáveis de ambiente do projeto. Copie para `.env` (nunca
# `env`/`env.txt` — só `load_dotenv()` lê exatamente `.env`) e preencha os
# valores reais. `.env` nunca vai ao Git (ver .gitignore).

# ---------------------------------------------------------------------
# LLM do chatbot: Claude (Anthropic), crédito pré-pago
# (backend/busca/llm_anthropic.py). Sem a chave, o chat degrada de forma
# controlada (candidatos por palavras para escolha manual).
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODELO=claude-haiku-4-5-20251001
# ANTHROPIC_TIMEOUT_S=20


# ---------------------------------------------------------------------
# Acesso (backend/acesso.py, BLOCO 3 do plano) — autenticação mínima e
# guardrails de custo.
# ---------------------------------------------------------------------
# Senha compartilhada de login. Obrigatória para expor o sistema fora de
# localhost -- sem ela, nenhum login é aceito.
# ACESSO_SENHA=

# Chave separada para assinar o cookie de sessão. Se ausente, deriva de
# ACESSO_SENHA (funciona, mas não é o ideal em produção).
# ACESSO_SECRET_KEY=

# O cookie de sessão sai com `secure=True` por padrão (só viaja por
# HTTPS) -- correto para Render/domínio do projeto. Ligue isto (valor "1")
# SÓ para testar localmente em http://localhost sem HTTPS/túnel; nunca em
# produção.
# ACESSO_COOKIE_INSEGURO=0

# Guardrails de custo: só contam as buscas que chegam ao LLM (busca sem LLM
# é ilimitada). Esgotado, a busca segue por palavras. "0" é válido (nenhum LLM).
# ACESSO_LIMITE_GLOBAL_DIA=1500         # buscas no LLM por dia, somando todos
# ACESSO_LIMITE_LLM_PESSOA_DIA=60       # buscas que chegam ao LLM, por pessoa, por dia de Brasília (0 = nenhuma)
# ACESSO_CONSULTORES=Nome Um;Nome Dois   # lista do login (separada por ;). Vazia = nome livre. Não versionar os nomes.
